import gpdraw.*;

public class P3_Thatte_Sanika_RectangleDriver{
    public static void main(String[] args){
        SketchPad pad = new SketchPad(300,300);
        Rectangle r1 = new Rectangle(-150, -150, 200, 300, pad);
        Rectangle r2 = new Rectangle(-50, -150, 200, 300, pad);
        Rectangle r3 = new Rectangle(-150, -50, 300, 100, pad);
    
        r1.draw();
        r2.draw();
        r3.draw();
        
        System.out.println("Perimeter of Rectangle 1: " + r1.calcPerimeter());
        System.out.println("Perimeter of Rectangle 2: " + r2.calcPerimeter());
        System.out.println("Perimeter of Rectangle 3: " + r3.calcPerimeter()+"\n");
        
        System.out.println("Area of Rectangle 1: " + r1.calcArea());
        System.out.println("Area of Rectangle 2: " + r2.calcArea());
        System.out.println("Perimeter of Rectangle 3: " + r3.calcArea());
    }
}
